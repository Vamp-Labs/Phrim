{
  "name": "phrim",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.18.1",
    "pnpm": "11.4.0"
  },
  "packageManager": "pnpm@11.4.0",
  "type": "module",
  "dependencies": {
    "@scure/bip39": "2.4.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.3",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "3.1.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "3.0.2",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "4.2.0",
    "@midnight-ntwrk/wallet-sdk-facade": "4.1.0",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "contract:compile": "pnpm --filter @phrim/contract run compile",
    "contract:test": "pnpm --filter @phrim/contract run test",
    "contract:deploy": "pnpm --filter @phrim/contract run deploy",
    "contract:reset": "pnpm --filter @phrim/contract run reset"
  }
}
